package linux.syscalls.native

unsafe fn read(fd: U32, buf: MutPtr<CChar>, count: Usize) -> AbiResult {
    syscall(0, fd, buf, count)
}

unsafe fn write(fd: U32, buf: ConstPtr<CChar>, count: Usize) -> AbiResult {
    syscall(1, fd, buf, count)
}

unsafe fn open(path: CString, flags: I32, mode: U16) -> AbiResult {
