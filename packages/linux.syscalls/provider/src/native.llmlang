}

unsafe fn fstat(fd: U32, statbuf: MutPtr<stat>) -> AbiResult {
    syscall(5, fd, statbuf)
}

unsafe fn lstat(filename: ConstPtr<CChar>, statbuf: MutPtr<stat>) -> AbiResult {
