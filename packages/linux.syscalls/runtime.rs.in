#![forbid(unsafe_code)]
#![allow(unused_imports)]

use std::ffi::{CStr, CString};
use std::io::{IoSlice, IoSliceMut};
use std::os::fd::{AsFd, BorrowedFd};
use std::sync::OnceLock;

fn stdin_fd() -> BorrowedFd<'static> {
    static STDIN: OnceLock<std::io::Stdin> = OnceLock::new();
    STDIN.get_or_init(std::io::stdin).as_fd()
}

fn stdout_fd() -> BorrowedFd<'static> {
    static STDOUT: OnceLock<std::io::Stdout> = OnceLock::new();
    STDOUT.get_or_init(std::io::stdout).as_fd()
}

fn cli_paths() -> Result<(CString, CString), Box<dyn std::error::Error>> {
    use std::os::unix::ffi::OsStrExt;
    let mut args = std::env::args_os().skip(1);
    let source = args.next().ok_or("expected a source and destination path")?;
    let destination = args.next().ok_or("expected a source and destination path")?;
    if args.next().is_some() {
        return Err("expected exactly two paths".into());
    }
    Ok((
        CString::new(source.as_os_str().as_bytes())?,
        CString::new(destination.as_os_str().as_bytes())?,
    ))
}

fn process_exit(status: i32) -> ! {
    std::process::exit(status)
}

use std::net::{Ipv4Addr, SocketAddrV4};

fn loopback_ephemeral() -> SocketAddrV4 {
    SocketAddrV4::new(Ipv4Addr::LOCALHOST, 0)
}
