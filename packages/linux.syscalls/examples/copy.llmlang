import linux.syscalls.close
import linux.syscalls.openat
import linux.syscalls.read
import linux.syscalls.write

fn copy_bytes(input: BorrowedFd<'_>, output: BorrowedFd<'_>) -> Result<(), Box<dyn std::error::Error>> {
    let mut buffer = [0_u8; 16384];
    loop {
        let count = match read(input, &mut buffer) {
            Ok(ReadOutcome::Eof) => return Ok(()),
            Ok(ReadOutcome::Progress(count)) => count,
            Err(error) if error.is_errno(EINTR) => continue,
            Err(error) => return Err(error.into()),
        };
        let mut sent = 0;
        while sent < count {
            match write(output, &buffer[sent..count]) {
                Ok(0) => return Err("write returned zero before completing the copy".into()),
                Ok(progress) => sent += progress,
                Err(error) if error.is_errno(EINTR) => continue,
                Err(error) => return Err(error.into()),
            }
        }
    }
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let (source, destination) = cli_paths()?;
    let input = openat(Directory::Current, &source, OpenOptions { flags: O_RDONLY, mode: 0 })?;
    let output = match openat(
        Directory::Current,
        &destination,
        OpenOptions { flags: O_WRONLY | O_CREAT | O_EXCL, mode: 0o600 },
    ) {
        Ok(output) => output,
        Err(error) => {
            let _input_close = close(input);
            return Err(error.into());
        },
    };

    let copied = copy_bytes(input.borrow(), output.borrow());
    let output_close = close(output);
    let input_close = close(input);
    copied?;
    output_close?;
    input_close?;
    Ok(())
}
