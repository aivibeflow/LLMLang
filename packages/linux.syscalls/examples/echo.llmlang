import linux.syscalls.read
import linux.syscalls.write

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let mut buffer = [0_u8; 8192];
    loop {
        let count = match read(stdin_fd(), &mut buffer) {
            Ok(ReadOutcome::Eof) => return Ok(()),
            Ok(ReadOutcome::Progress(count)) => count,
            Err(error) if error.is_errno(EINTR) => continue,
            Err(error) => return Err(error.into()),
        };
        let mut sent = 0;
        while sent < count {
            match write(stdout_fd(), &buffer[sent..count]) {
                Ok(0) => return Err("write returned zero before completing Echo".into()),
                Ok(progress) => sent += progress,
                Err(error) if error.is_errno(EINTR) => continue,
                Err(error) => return Err(error.into()),
            }
        }
    }
}
