import linux.syscalls.accept
import linux.syscalls.bind
import linux.syscalls.close
import linux.syscalls.connect
import linux.syscalls.getsockname
import linux.syscalls.listen
import linux.syscalls.read
import linux.syscalls.socket
import linux.syscalls.write

fn send(fd: BorrowedFd<'_>, bytes: &[u8]) -> Result<(), Box<dyn std::error::Error>> {
    let mut sent = 0;
    while sent < bytes.len() {
        match write(fd, &bytes[sent..]) {
            Ok(0) => return Err("write returned zero before completing the message".into()),
            Ok(progress) => sent += progress,
            Err(error) if error.is_errno(EINTR) => continue,
            Err(error) => return Err(error.into()),
        }
    }
    Ok(())
}

fn receive(fd: BorrowedFd<'_>, bytes: &mut [u8]) -> Result<(), Box<dyn std::error::Error>> {
    let mut received = 0;
    while received < bytes.len() {
        match read(fd, &mut bytes[received..]) {
            Ok(ReadOutcome::Progress(progress)) => received += progress,
            Ok(ReadOutcome::Eof) => return Err("the peer closed before delivering the message".into()),
            Err(error) if error.is_errno(EINTR) => continue,
            Err(error) => return Err(error.into()),
        }
    }
    Ok(())
}

fn exchange(client: BorrowedFd<'_>, server: BorrowedFd<'_>) -> Result<(), Box<dyn std::error::Error>> {
    let message = b"LLMLang TCP echo\x00\xFF\n";
    let mut request = [0_u8; 19];
    let mut response = [0_u8; 19];
    send(client, message)?;
    receive(server, &mut request)?;
    send(server, &request)?;
    receive(client, &mut response)?;
    if &response != message {
        return Err("the loopback response differs from the request".into());
    }
    send(stdout_fd(), &response)
}

fn connect_and_echo(listener: BorrowedFd<'_>, client: BorrowedFd<'_>) -> Result<(), Box<dyn std::error::Error>> {
    connect(client, getsockname(listener)?)?;
    let server = accept(listener)?;
    let exchanged = exchange(client, server.borrow());
    let server_close = close(server);
    exchanged?;
    server_close?;
    Ok(())
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let listener = socket()?;
    bind(listener.borrow(), loopback_ephemeral())?;
    listen(listener.borrow(), 1)?;
    let client = socket()?;
    let exchanged = connect_and_echo(listener.borrow(), client.borrow());
    let client_close = close(client);
    let listener_close = close(listener);
    exchanged?;
    client_close?;
    listener_close?;
    Ok(())
}
