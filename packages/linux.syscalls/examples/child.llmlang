import linux.syscalls.exit_group
import linux.syscalls.fork_execve
import linux.syscalls.wait4

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let args = [c"sh", c"-c", c"exit 23"];
    let image = ExecImage::new(c"/bin/sh", &args, &[])?;
    let mut child = fork_execve(&image)?;
    loop {
        match wait4(&mut child, 0) {
            Ok(Some(status)) => match status.exited() {
                Some(code) => match exit_group(i32::from(code)) {
                    Ok(never) => match never {},
                    Err(error) => return Err(error.into()),
                },
                _ => return Err("the child did not exit normally".into()),
            },
            Ok(_) => return Err("blocking wait4 returned without a child status".into()),
            Err(error) if error.is_errno(EINTR) => continue,
            Err(error) => return Err(error.into()),
        }
    }
}
