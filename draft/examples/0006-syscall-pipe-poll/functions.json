, 1) == 1\n        && byte[0] == b'x';\n    let output_closed = close(fds[1] as U32);\n    let input_closed = close(fds[0] as U32);\n    if passed && output_closed == 0 && input_closed == 0 { return 0; }\n    return 1;\n}"}}]}},"implHash":"sha256:182274eb17865767d210c5ab9397ec572ec0aeff95fd02fc8afab0d142802800","providedContractHash":"sha256:3b4f01c7d399a35060b68b7ec6d6792664f23e238f525f8b81f7b578902d0c2c","typedSignature":{"objectValue":{"fields":[{"key":"parameters","value":{"listValue":{}}},{"key":"result","value":{"stringValue":"ExitStatus"}}]}}}
