import linux.syscalls.close
import linux.syscalls.openat
import linux.syscalls.read
import linux.syscalls.write
import stdlib.cstring_from_bytes
import stdlib.errno_message

pub fn main(args: LaunchArgs) -> ExitStatus {
    if args.len() != 2 { return 2; }
    let source = match cstring_from_bytes(&args[0]) {
        Ok(path) => path,
        Err(_) => return 2,
    };
    let destination = match cstring_from_bytes(&args[1]) {
        Ok(path) => path,
        Err(_) => return 2,
    };
    let result = 'transfer: {
        let input = openat(AT_FDCWD, source, O_RDONLY | O_CLOEXEC, 0);
        if input < 0 { break 'transfer input; }
        let output = openat(AT_FDCWD, destination, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0o600);
        if output < 0 {
            close(input as U32);
            break 'transfer output;
        }
        let mut buffer = [0_u8; 16384];
        let capacity = buffer.len();
        let result = 'copy: loop {
            let count = read(input as U32, &mut buffer, capacity);
            if count == -EINTR { continue; }
            if count < 0 { break count; }
            if count == 0 { break 0; }
            let count = count as Usize;
            let mut sent = 0;
            while sent < count {
                let written = write(output as U32, &buffer[sent..count], count - sent);
                if written == -EINTR { continue; }
                if written < 0 { break 'copy written; }
                if written == 0 { break 'copy 1; }
                sent += written as Usize;
            }
        };
        let output_closed = close(output as U32);
        let input_closed = close(input as U32);
        if result != 0 { break 'transfer result; }
        if output_closed < 0 { break 'transfer output_closed; }
        input_closed
    };
    if result < 0 {
        let diagnostic = errno_message(-result);
        write(2, &diagnostic[..], diagnostic.len());
    }
    if result != 0 { return 1; }
    return 0;
}
