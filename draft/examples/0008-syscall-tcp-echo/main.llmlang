import linux.syscalls.accept
import linux.syscalls.bind
import linux.syscalls.close
import linux.syscalls.connect
import linux.syscalls.getsockname
import linux.syscalls.listen
import linux.syscalls.read
import linux.syscalls.socket
import linux.syscalls.write

pub fn main() -> ExitStatus {
    let listener = socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, 0);
    if listener < 0 { return 1; }
    let listener = listener as I32;
    let mut address = sockaddr_in::loopback(0);
    let mut address_size = size_of::<sockaddr_in>() as I32;
    let mut client = -1_i32;
    let mut server = -1_i32;
    let mut status = 1;
    'exchange: {
        if bind(listener, &mut address as MutPtr<sockaddr>, address_size) < 0
            || listen(listener, 1) < 0
            || getsockname(listener, &mut address as MutPtr<sockaddr>, &mut address_size) < 0 {
            break 'exchange;
        }
        client = socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, 0) as I32;
        if client < 0 || connect(client, &mut address as MutPtr<sockaddr>, address_size) < 0 {
            break 'exchange;
        }
        server = accept(listener, null, null) as I32;
        if server < 0 { break 'exchange; }

        let message = b"LLMLang TCP echo\x00\xFF\n";
        let mut received = [0_u8; 19];
        let mut response = [0_u8; 19];

        for (source, destination, bytes) in [
            (client, server, &mut received),
            (server, client, &mut response),
        ] {
            let mut sent = 0;
            while sent < message.len() {
                let written = write(source as U32, &message[sent..], message.len() - sent);
                if written == -EINTR { continue; }
                if written <= 0 { break 'exchange; }
                sent += written as Usize;
            }
            let mut count = 0;
            while count < bytes.len() {
                let remaining = bytes.len() - count;
                let read_count = read(destination as U32, &mut bytes[count..], remaining);
                if read_count == -EINTR { continue; }
                if read_count <= 0 { break 'exchange; }
                count += read_count as Usize;
            }
            if &*bytes != message { break 'exchange; }
        }
        let mut sent = 0;
        while sent < response.len() {
            let written = write(1, &response[sent..], response.len() - sent);
            if written == -EINTR { continue; }
            if written <= 0 { break 'exchange; }
            sent += written as Usize;
        }
        status = 0;
    }
    if server >= 0 && close(server as U32) < 0 { status = 1; }
    if client >= 0 && close(client as U32) < 0 { status = 1; }
    if close(listener as U32) < 0 { status = 1; }
    return status;
}
