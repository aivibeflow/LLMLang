; Independent declarative formulation of the finite local claim.
(set-logic QF_UF)
(declare-const pin Bool)
(declare-const snapshot Bool)
(declare-const ordered Bool)
(declare-const rebuild Bool)
(declare-const exact_hit Bool)
(declare-const exact_evidence Bool)
(declare-const fresh Bool)
(declare-const settled Bool)
(declare-const authorized Bool)
(declare-const diagnostic Bool)
(declare-const rebound Bool)
(declare-const cancel Bool)
(declare-const larger_scope Bool)
(declare-const revoked Bool)
(assert (not (and pin snapshot)))
(assert (not (and rebuild exact_hit)))
(define-fun blocked () Bool
  (or (not (or pin snapshot))
      (not (or rebuild exact_hit))
      (and cancel (or (not fresh) (not settled)))
      (and (not diagnostic)
           (not (and ordered exact_evidence fresh settled authorized)))))
(define-fun withheld () Bool
  (and (not blocked)
       (or (and pin rebound) larger_scope (and revoked (not diagnostic)))))
(define-fun admitted () Bool (not (or blocked withheld)))
