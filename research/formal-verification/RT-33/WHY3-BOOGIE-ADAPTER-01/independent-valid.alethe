(assume p (= i 3))
(assume n (not (= (+ i 1) 4)))
(step a (cl (not (= i 3)) (<= (+ i 1) 4)) :rule la_generic :args ((- 1) 1))
(step b (cl (not (= i 3)) (<= 4 (+ i 1))) :rule la_generic :args (1 1))
(step c (cl (<= (+ i 1) 4)) :rule resolution :premises (a p))
(step d (cl (<= 4 (+ i 1))) :rule resolution :premises (b p))
(step e (cl (or (= (+ i 1) 4) (not (<= (+ i 1) 4)) (not (<= 4 (+ i 1))))) :rule la_disequality)
(step f (cl (= (+ i 1) 4) (not (<= (+ i 1) 4)) (not (<= 4 (+ i 1)))) :rule or :premises (e))
(step g (cl (= (+ i 1) 4)) :rule resolution :premises (f c d))
(step h (cl) :rule resolution :premises (g n))
