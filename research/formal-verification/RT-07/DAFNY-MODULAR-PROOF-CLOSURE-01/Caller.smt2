(set-logic QF_LIA)
(declare-const base Int)
(declare-const last Int)
(declare-const ordinal Int)
(assert (and (<= 0 base) (<= base 18446744073709551615)
             (<= 0 last) (<= 0 ordinal)
             (<= (+ base (* 16 last)) 18446744073709551615)
             (< 18446744073709551615 (+ base (* 16 (+ last 1))))
             (distinct (<= ordinal last) (<= (+ base (* 16 ordinal)) 18446744073709551615))))
(check-sat)
