trapped:
  li t0, TIMER_CAUSE
  beq s7, t0, timer
  li t0, 8
  bne s7, t0, fail
  li t0, 2
  beq a7, t0, stopping
  li t0, 3
  beq a7, t0, block_receiver
  li t0, 5
  beq a7, t0, resolve_waiter
  li t0, 6
  beq a7, t0, stale_request
  j report_user_fault

timer:
  ld t0, 0(sp)
  la t1, user_entry
  bltu t0, t1, fail
  la t1, user_end
  bgeu t0, t1, fail
  andi t0, t0, 3
  bnez t0, fail
  ld t2, 0(s5)
  addi t2, t2, 1
  bgtu t2, a2, fail
  sd t2, 0(s5)
  sd t2, 128(sp)
  mv a0, s6
  call uart
  ld t0, 0(s4)
  bnez t0, resume
.if MUTANT != 1
  la t0, context_a
  bne s2, t0, switch_task
  la t0, waiting
  ld t1, 0(t0)
  bnez t1, resume
.endif
switch_task:
  mv sp, s2
  j resume

block_receiver:
  bnez a1, fail
  la t0, receive_call
  ld t1, 0(sp)
  bne t0, t1, fail
  addi t1, t1, 4
  sd t1, 0(sp)
  la t0, waiting
  ld t1, 0(t0)
  bnez t1, fail
  li t1, 1
  sd t1, 0(t0)
  li a0, 'W'
  call uart
  j switch_task

resolve_waiter:
  beqz a1, fail
  la t0, resolve_call
  ld t1, 0(sp)
  bne t0, t1, fail
  addi t1, t1, 4
  sd t1, 0(sp)
  la t0, waiting
  ld t1, 0(t0)
  beqz t1, fail
  la t2, endpoint_generation
  ld t1, 0(t2)
  bne t1, a0, fail
  sd zero, 0(t0)
.if MODE == 0
  li t1, 41
  li a0, 'D'
.else
  addi t1, t1, 1
  sd t1, 0(t2)
  li t1, 17
  li a0, 'C'
.endif
  sd t1, 80(s2)
  call uart
  j switch_task

stale_request:
  beqz a1, fail
  la t0, stale_call
  ld t1, 0(sp)
  bne t0, t1, fail
  addi t1, t1, 4
  sd t1, 0(sp)
  la t0, endpoint_generation
  ld t1, 0(t0)
  beq a0, t1, fail
.if MUTANT == 3
  sd zero, 80(sp)
.else
  li t0, 2
  sd t0, 80(sp)
.endif
  li a0, 'R'
  call uart
  j resume
