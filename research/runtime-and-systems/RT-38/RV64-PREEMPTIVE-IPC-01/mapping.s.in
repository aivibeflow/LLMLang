  li t0, -1
  csrw pmpaddr0, t0
  li t0, 0xf                      // Physical aperture for the Sv39 fixture.
  csrw pmpcfg0, t0
  la t0, root_a
  la t1, tables_end
clear_tables:
  sd zero, 0(t0)
  addi t0, t0, 8
  bne t0, t1, clear_tables

.macro map table, offset, frame, flags
  la t0, \table
  la t1, \frame
  srli t1, t1, 12
  slli t1, t1, 10
  ori t1, t1, \flags
  sd t1, \offset(t0)
.endm

  map root_a, 16, directory_a, 1
  map root_b, 16, directory_b, 1
  map directory_a, 8, leaves_a, 1
  map directory_b, 8, leaves_b, 1
  map leaves_a, 0, user_entry, 0x5b
  map leaves_b, 0, user_entry, 0x5b
  map leaves_a, 8, stack_a, 0xd7
.if MUTANT == 2
  map leaves_b, 8, stack_a, 0xd7
.else
  map leaves_b, 8, stack_b, 0xd7
.endif
  fence rw, rw
  sfence.vma zero, zero
