user_entry:
  addi sp, sp, -16
  addi s0, a1, 100
  addi t3, a1, 200
  sd s0, 0(sp)
  bnez a1, sender_wait
  li a7, 3
receive_call:
  ecall
  ld t0, 0(sp)
  bne t0, s0, bad_stack
  beqz a4, received
  li t0, 17
  j check_reply
received:
  li t0, 41
check_reply:
  bne a0, t0, bad_result
receiver_wait:
  bltu a6, a2, receiver_wait
  j check_state
sender_wait:
  bltu a6, a2, sender_wait
  li a7, 5
  li a0, 1
resolve_call:
  ecall
  beqz a4, check_state
  li a7, 6
  li a0, 1
stale_call:
  ecall
  li t0, 2
  bne a0, t0, bad_result
check_state:
  addi t0, a1, 100
  bne s0, t0, bad_result
  ld t1, 0(sp)
  bne t0, t1, bad_stack
  addi t0, a1, 200
  bne t3, t0, bad_result
  li a7, 2
user_stop:
  ecall
  j .
bad_stack:
  li a7, 242
  j user_fault
bad_result:
  li a7, 243
user_fault:
  ecall
  j .
