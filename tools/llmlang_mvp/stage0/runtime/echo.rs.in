use std::os::unix::ffi::OsStrExt;

fn main() {
    let mut output = Vec::new();
    for (index, argument) in std::env::args_os().skip(1).enumerate() {
        if index > 0 {
            output.push(b' ');
        }
        output.extend_from_slice(argument.as_os_str().as_bytes());
    }
    output.push(b'\n');
    std::process::exit(write_output(&output));
}
